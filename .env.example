# Database: local file for development, a Turso/libSQL URL in production.
DATABASE_URL=file:./data/rescue.db
# DATABASE_AUTH_TOKEN=            # required for hosted Turso databases

# Session signing secret. Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Public site URL (used for absolute links on printed slips)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First admin account, created by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
